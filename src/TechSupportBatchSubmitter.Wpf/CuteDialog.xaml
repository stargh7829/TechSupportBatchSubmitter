<Window x:Class="TechSupportBatchSubmitter.Wpf.CuteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFF8F6"/>
            <Setter Property="Foreground" Value="#2E2A32"/>
            <Setter Property="BorderBrush" Value="#F2D5CE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFEDEA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F9DDD8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#FFFCFB"
            BorderBrush="#F2D5CE"
            BorderThickness="1"
            CornerRadius="18"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="54" Height="54" CornerRadius="16"
                    Background="#FFF1EE"
                    BorderBrush="#F2D5CE"
                    BorderThickness="1">
                <Image Source="Assets/CatMascot.png" Stretch="Uniform" Margin="3"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,2,0,0">
                <TextBlock x:Name="TitleText"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#2E2A32"/>
                <TextBlock x:Name="MessageText"
                           Margin="0,8,0,0"
                           Foreground="#5F5664"
                           TextWrapping="Wrap"
                           LineHeight="22"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="CancelButton"
                        Content="取消"
                        MinWidth="86"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click"/>
                <Button x:Name="OkButton"
                        Content="确定"
                        MinWidth="86"
                        Padding="14,7"
                        Background="#FF7B9C"
                        Foreground="White"
                        BorderBrush="#FF7B9C"
                        Click="OkButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
