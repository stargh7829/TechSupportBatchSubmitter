<Window x:Class="TechSupportBatchSubmitter.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="技术支持批量提交工具"
        Icon="Assets/AppIcon.ico"
        Width="1500"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F4"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBgBrush" Color="#FFF7F4"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#FFF1EE"/>
        <SolidColorBrush x:Key="LineBrush" Color="#F2D5CE"/>
        <SolidColorBrush x:Key="TextBrush" Color="#2E2A32"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7D7382"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF7B9C"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF668B"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#F0527B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFC857"/>
        <SolidColorBrush x:Key="BlueSoftBrush" Color="#EAF6FF"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E05252"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="#FFF8F6"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFEDEA"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#EEBFB8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F9DDD8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B6ABB8"/>
                                <Setter TargetName="Root" Property="Background" Value="#F7F2F0"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#E8DDD9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFF7F4"/>
                                <Setter TargetName="Root" Property="Background" Value="#E8B6C5"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#E8B6C5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="#F0C8C8"/>
            <Setter Property="Background" Value="#FFF5F5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFCFB"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#E9CFC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#F7F1EF"/>
                                <Setter Property="Foreground" Value="#B6ABB8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#FFFCFB"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#E9CFC8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1E4E0"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#FFFBFA"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF1EE"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#F1D5CE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF7D9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE6EF"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFF1EE" BorderBrush="#F2D5CE" BorderThickness="0,0,0,1" Padding="22,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="16"
                            Background="White" BorderBrush="#F2D5CE" BorderThickness="1"
                            Margin="0,0,12,0">
                        <Image Source="Assets/CatMascot.png" Stretch="Uniform" Margin="3"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="技术支持批量提交工具" Foreground="{StaticResource TextBrush}"
                                   FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="批量提交、待受理查询、提交清单关闭、编号核验与断点恢复"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionStatusText" Text="正在初始化官方登录页面"
                               Foreground="#D88600" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="CurrentUserText" Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LoginColumn" Width="420" MinWidth="0"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="8"/>
                <ColumnDefinition x:Name="WorkspaceColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LoginPane" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#FFF8F6" BorderBrush="#F2D5CE"
                            BorderThickness="0,0,0,1" Padding="12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="官方登录页面" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="最小化"
                                            MinWidth="72"
                                            Click="ToggleLoginCollapse_Click"/>
                                    <Button x:Name="ExpandLoginButton" Content="放大页面"
                                            MinWidth="72"
                                            Click="ToggleLoginPane_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="可拖动右侧分隔条调整宽度。程序不保存密码。"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"/>
                            <WrapPanel>
                                <Button Content="工作台/重新登录" Click="OpenWorkbench_Click"/>
                                <Button Content="打开技术支持" Click="OpenSupport_Click"/>
                                <Button Content="检查登录" Click="CheckSession_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <wv2:WebView2 x:Name="PlatformWebView" Grid.Row="1"/>
                </Grid>
            </Border>

            <Border x:Name="CollapsedLoginBar"
                    Grid.Column="0"
                    Visibility="Collapsed"
                    Background="#FFF8F6"
                    BorderBrush="#F2D5CE"
                    BorderThickness="1"
                    CornerRadius="14">
                <Button Content="恢复&#x0a;页面"
                        MinWidth="36"
                        Padding="4,12"
                        Margin="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Click="ToggleLoginCollapse_Click"/>
            </Border>

            <GridSplitter x:Name="LoginSplitter"
                          Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="#F2D5CE"
                          ShowsPreview="True"/>

            <TabControl x:Name="WorkspaceTabs" Grid.Column="2"
                        Background="Transparent" BorderThickness="0">
                <TabItem Header="批量提交">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="180"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="选择 Excel 清单" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="选择后自动读取并创建备份；点击开始提交时自动校验平台字段"
                                               HorizontalAlignment="Right" Foreground="#657186"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WorkbookPathText" Height="34" Padding="8,5"
                                             IsReadOnly="True" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BrowseButton" Grid.Column="1"
                                            Content="选择并读取" Margin="10,0,0,0"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="BrowseWorkbook_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,10">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel><TextBlock x:Name="TotalText" Text="0" Style="{StaticResource StatValue}"/><TextBlock Text="总数" Style="{StaticResource StatLabel}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel><TextBlock x:Name="SucceededText" Text="0" Style="{StaticResource StatValue}" Foreground="#067647"/><TextBlock Text="成功" Style="{StaticResource StatLabel}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel><TextBlock x:Name="PendingText" Text="0" Style="{StaticResource StatValue}"/><TextBlock Text="待提交" Style="{StaticResource StatLabel}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel><TextBlock x:Name="FailedText" Text="0" Style="{StaticResource StatValue}" Foreground="#B42318"/><TextBlock Text="失败" Style="{StaticResource StatLabel}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel><TextBlock x:Name="ValidationFailedText" Text="0" Style="{StaticResource StatValue}" Foreground="#B54708"/><TextBlock Text="校验失败" Style="{StaticResource StatLabel}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel><TextBlock x:Name="PendingVerificationText" Text="0" Style="{StaticResource StatValue}" Foreground="#175CD3"/><TextBlock Text="待核验" Style="{StaticResource StatLabel}"/></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <WrapPanel>
                                    <Button x:Name="StartButton" Content="开始提交"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="StartSubmission_Click" IsEnabled="False"/>
                                    <Button x:Name="PauseButton" Content="暂停"
                                            Click="PauseSubmission_Click" IsEnabled="False"/>
                                    <Button x:Name="RetryButton" Content="仅重试失败项"
                                            Click="RetryFailed_Click" IsEnabled="False"/>
                                    <Button x:Name="StopButton" Content="停止"
                                            Style="{StaticResource DangerButton}"
                                            Click="StopSubmission_Click" IsEnabled="False"/>
                                </WrapPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="提交间隔" Foreground="#657186" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SubmissionIntervalText"
                                             Width="58" Height="28" Padding="6,3"
                                             Margin="8,0,4,0"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Text="秒；空白随机 30-90 秒"
                                               Foreground="#657186" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="当前行：" Foreground="#657186"/>
                                    <TextBlock x:Name="CurrentRowText" Text="-" FontWeight="SemiBold" Margin="0,0,18,0"/>
                                    <TextBlock Text="倒计时：" Foreground="#657186"/>
                                    <TextBlock x:Name="CountdownText" Text="00:00" FontWeight="SemiBold"
                                               FontSize="18" Foreground="#175CD3"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10">
                            <DataGrid x:Name="TicketGrid" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="All"
                                      BorderThickness="0" ItemsSource="{Binding Rows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="58"/>
                                    <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*"/>
                                    <DataGridTextColumn Header="发现人" Binding="{Binding Discoverer}" Width="95"/>
                                    <DataGridTextColumn Header="申请人" Binding="{Binding Applicant}" Width="95"/>
                                    <DataGridTextColumn Header="事件类型" Binding="{Binding EventType}" Width="100"/>
                                    <DataGridTextColumn Header="所属系统" Binding="{Binding SystemName}" Width="110"/>
                                    <DataGridTextColumn Header="指定受理人" Binding="{Binding Assignee}" Width="105"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="78"/>
                                    <DataGridTextColumn Header="技术支持编号" Binding="{Binding TicketNumber}" Width="110"/>
                                    <DataGridTextColumn Header="实际提交时间"
                                                        Binding="{Binding SubmittedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                        Width="145"/>
                                    <DataGridTextColumn Header="失败原因" Binding="{Binding FailureReason}" Width="2*"/>
                                    <DataGridTextColumn Header="关闭状态" Binding="{Binding CloseStateText}" Width="86"/>
                                    <DataGridTextColumn Header="实际关闭时间"
                                                        Binding="{Binding ClosedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                        Width="145"/>
                                    <DataGridTextColumn Header="关闭失败原因" Binding="{Binding CloseFailureReason}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#F8FAFD" BorderBrush="#DCE3EC"
                                        BorderThickness="0,0,0,1" Padding="10,7">
                                    <Grid>
                                        <TextBlock Text="运行日志" FontWeight="SemiBold"/>
                                        <TextBlock Text="日志不记录描述、密码、Cookie、身份证号或手机号"
                                                   HorizontalAlignment="Right" Foreground="#657186"/>
                                    </Grid>
                                </Border>
                                <ListBox x:Name="LogList" Grid.Row="1" BorderThickness="0"
                                         FontFamily="Consolas" FontSize="12"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="待受理查询">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="待受理事项 - 未受理" FontSize="16" FontWeight="SemiBold"/>
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="420"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="事件标题：" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PendingTitleText" Grid.Column="1"
                                             Height="34" Padding="8,5"
                                             VerticalContentAlignment="Center"/>
                                    <Button x:Name="QueryPendingButton" Grid.Column="2"
                                            Content="查询" Margin="10,0,0,0"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="QueryPending_Click"/>
                                    <Button x:Name="TogglePendingAdvancedButton" Grid.Column="3"
                                            Content="更多条件"
                                            HorizontalAlignment="Left"
                                            Click="TogglePendingAdvanced_Click"/>
                                    <Button Grid.Column="3" Content="清空"
                                            HorizontalAlignment="Left"
                                            Margin="88,0,0,0"
                                            Click="ResetPendingQuery_Click"/>
                                </Grid>
                                <Grid x:Name="PendingAdvancedPanel"
                                      Grid.Row="2"
                                      Visibility="Collapsed"
                                      Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="事件编号：" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PendingCaseIdText" Grid.Column="1" Height="30" Padding="6,3"/>
                                    <TextBlock Grid.Column="2" Text="事件类型：" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    <TextBox x:Name="PendingTypeText" Grid.Column="3" Height="30" Padding="6,3"/>
                                    <TextBlock Grid.Column="4" Text="所属系统：" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    <TextBox x:Name="PendingSystemText" Grid.Column="5" Height="30" Padding="6,3"/>
                                    <TextBlock Grid.Column="6" Text="事件状态：" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    <TextBox x:Name="PendingStatusText" Grid.Column="7" Height="30" Padding="6,3"/>

                                    <TextBlock Grid.Row="1" Text="受理人：" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBox x:Name="PendingAssigneeText" Grid.Row="1" Grid.Column="1" Height="30" Padding="6,3" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="申请人：" VerticalAlignment="Center" Margin="14,8,0,0"/>
                                    <TextBox x:Name="PendingApplicantText" Grid.Row="1" Grid.Column="3" Height="30" Padding="6,3" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="当前处理人：" VerticalAlignment="Center" Margin="14,8,0,0"/>
                                    <TextBox x:Name="PendingHandlerText" Grid.Row="1" Grid.Column="5" Height="30" Padding="6,3" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="6" Text="申请人所属机构：" VerticalAlignment="Center" Margin="14,8,0,0"/>
                                    <TextBox x:Name="PendingCreatorOrgText" Grid.Row="1" Grid.Column="7" Height="30" Padding="6,3" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="2" Text="创建开始：" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <DatePicker x:Name="PendingStartDatePicker" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="创建结束：" VerticalAlignment="Center" Margin="14,8,0,0"/>
                                    <DatePicker x:Name="PendingEndDatePicker" Grid.Row="2" Grid.Column="3" Height="30" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="关闭开始：" VerticalAlignment="Center" Margin="14,8,0,0"/>
                                    <DatePicker x:Name="PendingCloseStartDatePicker" Grid.Row="2" Grid.Column="5" Height="30" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="6" Text="关闭结束：" VerticalAlignment="Center" Margin="14,8,0,0"/>
                                    <DatePicker x:Name="PendingCloseEndDatePicker" Grid.Row="2" Grid.Column="7" Height="30" Margin="0,8,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="查询结果" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="  共 " Foreground="#657186"/>
                                    <TextBlock x:Name="PendingResultTotalText" Text="0" FontWeight="SemiBold"/>
                                    <TextBlock Text=" 条" Foreground="#657186"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="CloseProgressText" Text="请选择需要关闭的记录"
                                               Foreground="#526176" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="关贴间隔" Foreground="#657186" VerticalAlignment="Center"/>
                                    <TextBox x:Name="CloseIntervalText"
                                             Width="52" Height="28" Padding="6,3"
                                             Margin="8,0,4,0"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Text="秒" Foreground="#657186"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="倒计时：" Foreground="#657186" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CloseCountdownText" Text="00:00"
                                               FontWeight="SemiBold" Foreground="#175CD3"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button x:Name="BulkCloseButton" Content="批量关闭"
                                            Click="BulkClose_Click"/>
                                    <Button x:Name="PauseCloseButton" Content="暂停"
                                            Margin="8,0,0,0" Click="PauseClose_Click"/>
                                    <Button x:Name="StopCloseButton" Content="停止"
                                            Margin="8,0,0,0" Click="StopClose_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <DataGrid x:Name="PendingTicketGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      BorderThickness="0"
                                      FrozenColumnCount="3"
                                      ItemsSource="{Binding PendingTickets}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="72">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox x:Name="SelectAllPendingCheckBox"
                                                      Content="全选"
                                                      IsThreeState="True"
                                                      Click="SelectAllPending_Click"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanClose}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Click="PendingSelection_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="编号" Binding="{Binding CaseId}" Width="110" MinWidth="105" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="标题" Binding="{Binding CaseTitle}" Width="220" MinWidth="200" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="事件类型" Binding="{Binding TypeName}" Width="100" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="所属系统" Binding="{Binding SystemName}" Width="110" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="受理人" Binding="{Binding Assignee}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="当前处理人" Binding="{Binding CurrentHandler}" Width="100" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="申请人" Binding="{Binding Applicant}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="申请时间" Binding="{Binding CreateTime}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="最近回复时间" Binding="{Binding LatestReplyTime}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StatusName}" Width="80" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="关闭状态" Binding="{Binding CloseStateText}" Width="92" MinWidth="88" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="处理结果" Binding="{Binding CloseMessage}" Width="150" MinWidth="140" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="操作" Width="96" MinWidth="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="关闭"
                                                        IsEnabled="{Binding CanClose}"
                                                        MinWidth="56" Padding="8,4"
                                                        Click="ClosePendingTicket_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="提交清单关闭">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="按当前 Excel 提交清单关闭" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1"
                                           Text="来源为批量提交清单中已有技术支持编号的记录，关闭结果会回写到同一个 Excel。"
                                           Foreground="#657186" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="清单记录" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="  共 " Foreground="#657186"/>
                                    <TextBlock x:Name="ExcelCloseResultTotalText" Text="0" FontWeight="SemiBold"/>
                                    <TextBlock Text=" 条" Foreground="#657186"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="ExcelCloseProgressText" Text="请先选择 Excel 清单"
                                               Foreground="#526176" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="关贴间隔" Foreground="#657186" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ExcelCloseIntervalText"
                                             Width="52" Height="28" Padding="6,3"
                                             Margin="8,0,4,0"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Text="秒" Foreground="#657186"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="倒计时：" Foreground="#657186" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ExcelCloseCountdownText" Text="00:00"
                                               FontWeight="SemiBold" Foreground="#175CD3"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button x:Name="RefreshExcelCloseButton" Content="查询清单"
                                            Click="RefreshExcelCloseList_Click"/>
                                    <Button x:Name="BulkCloseExcelButton" Content="批量关闭"
                                            Click="BulkCloseExcel_Click"/>
                                    <Button x:Name="PauseExcelCloseButton" Content="暂停"
                                            Margin="8,0,0,0" Click="PauseClose_Click"/>
                                    <Button x:Name="StopExcelCloseButton" Content="停止"
                                            Margin="8,0,0,0" Click="StopClose_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <DataGrid x:Name="ExcelCloseTicketGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      BorderThickness="0"
                                      FrozenColumnCount="3"
                                      ItemsSource="{Binding ExcelCloseTickets}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="72">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox x:Name="SelectAllExcelCloseCheckBox"
                                                      Content="全选"
                                                      IsThreeState="True"
                                                      Click="SelectAllExcelClose_Click"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanClose}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Click="ExcelCloseSelection_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="编号" Binding="{Binding CaseId}" Width="100" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="标题" Binding="{Binding CaseTitle}" Width="2*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="事件类型" Binding="{Binding TypeName}" Width="100" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="所属系统" Binding="{Binding SystemName}" Width="110" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="指定受理人" Binding="{Binding Assignee}" Width="105" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="申请人" Binding="{Binding Applicant}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="提交时间" Binding="{Binding CreateTime}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="提交状态" Binding="{Binding StatusName}" Width="86" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="关闭状态" Binding="{Binding CloseStateText}" Width="86" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="关闭时间"
                                                        Binding="{Binding ClosedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                        Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="处理结果" Binding="{Binding CloseMessage}" Width="180" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="操作" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="关闭"
                                                        IsEnabled="{Binding CanClose}"
                                                        MinWidth="56" Padding="8,4"
                                                        Click="CloseExcelTicket_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="历史记录">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="本地历史记录" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="历史保存在本机 recovery.db，不记录描述、密码、Cookie、身份证号或手机号。"
                                               Foreground="#657186" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="刷新历史" Click="RefreshHistory_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <TabItem Header="提交历史">
                                <Border Style="{StaticResource Card}" Padding="0" Margin="0,8,0,0">
                                    <DataGrid AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="All"
                                              BorderThickness="0"
                                              ItemsSource="{Binding SubmissionHistory}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="时间"
                                                                Binding="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                                Width="150"/>
                                            <DataGridTextColumn Header="编号" Binding="{Binding CaseId}" Width="105"/>
                                            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*"/>
                                            <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="90"/>
                                            <DataGridTextColumn Header="事件类型" Binding="{Binding EventType}" Width="100"/>
                                            <DataGridTextColumn Header="所属系统" Binding="{Binding SystemName}" Width="110"/>
                                            <DataGridTextColumn Header="申请人" Binding="{Binding Applicant}" Width="90"/>
                                            <DataGridTextColumn Header="指定受理人" Binding="{Binding Assignee}" Width="105"/>
                                            <DataGridTextColumn Header="Excel路径" Binding="{Binding WorkbookPath}" Width="260"/>
                                            <DataGridTextColumn Header="工作表" Binding="{Binding WorksheetName}" Width="90"/>
                                            <DataGridTextColumn Header="Excel行" Binding="{Binding ExcelRowNumber}" Width="70"/>
                                            <DataGridTextColumn Header="结果" Binding="{Binding Message}" Width="180"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </TabItem>

                            <TabItem Header="关闭历史">
                                <Border Style="{StaticResource Card}" Padding="0" Margin="0,8,0,0">
                                    <DataGrid AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="All"
                                              BorderThickness="0"
                                              ItemsSource="{Binding CloseHistory}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="时间"
                                                                Binding="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                                Width="150"/>
                                            <DataGridTextColumn Header="来源" Binding="{Binding SourceKind}" Width="130"/>
                                            <DataGridTextColumn Header="编号" Binding="{Binding CaseId}" Width="105"/>
                                            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*"/>
                                            <DataGridTextColumn Header="关闭状态" Binding="{Binding StateText}" Width="90"/>
                                            <DataGridTextColumn Header="事件类型" Binding="{Binding EventType}" Width="100"/>
                                            <DataGridTextColumn Header="所属系统" Binding="{Binding SystemName}" Width="110"/>
                                            <DataGridTextColumn Header="申请人" Binding="{Binding Applicant}" Width="90"/>
                                            <DataGridTextColumn Header="受理人" Binding="{Binding Assignee}" Width="90"/>
                                            <DataGridTextColumn Header="Excel路径" Binding="{Binding WorkbookPath}" Width="260"/>
                                            <DataGridTextColumn Header="工作表" Binding="{Binding WorksheetName}" Width="90"/>
                                            <DataGridTextColumn Header="Excel行" Binding="{Binding ExcelRowNumber}" Width="70"/>
                                            <DataGridTextColumn Header="结果" Binding="{Binding Message}" Width="180"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="#FFF1EE" BorderBrush="#F2D5CE" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <TextBlock Text="支持批量提交、待受理查询、提交清单关闭、历史记录，以及固定规则的受理并总结。"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="FooterStatusText" Text="未选择 Excel"
                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
