<Window x:Class="TechSupportBatchSubmitter.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="技术支持批量提交工具"
        Icon="Assets/AppIcon.ico"
        Width="1500"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FFF7F4"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="AppBgBrush" Color="#FFF7F4"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#FFF1EE"/>
        <SolidColorBrush x:Key="LineBrush" Color="#F2D5CE"/>
        <SolidColorBrush x:Key="TextBrush" Color="#2E2A32"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7D7382"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF7B9C"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF668B"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#F0527B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFC857"/>
        <SolidColorBrush x:Key="InkBrush" Color="#2B2630"/>
        <SolidColorBrush x:Key="EarInnerBrush" Color="#FF9DAF"/>
        <SolidColorBrush x:Key="WhiskerBrush" Color="#E9BFB8"/>
        <SolidColorBrush x:Key="MintSoftBrush" Color="#E9F8F2"/>
        <SolidColorBrush x:Key="HoneySoftBrush" Color="#FFF7D9"/>
        <SolidColorBrush x:Key="BlueSoftBrush" Color="#EAF6FF"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E05252"/>
        <DrawingBrush x:Key="PawPatternBrush"
                      TileMode="Tile"
                      Viewport="0,0,44,44"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,44,44"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFDFB" Geometry="M0,0 H44 V44 H0 Z"/>
                    <GeometryDrawing Brush="#FFF2F7">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <EllipseGeometry Center="24,25" RadiusX="5.6" RadiusY="4.5"/>
                                <EllipseGeometry Center="18,18" RadiusX="2.2" RadiusY="2.7"/>
                                <EllipseGeometry Center="23,16" RadiusX="2.2" RadiusY="2.8"/>
                                <EllipseGeometry Center="28,18" RadiusX="2.2" RadiusY="2.7"/>
                                <EllipseGeometry Center="32,22" RadiusX="2.1" RadiusY="2.5"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="#FFF8F6"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,4,8,0"
                                        Opacity="0.22"
                                        IsHitTestVisible="False">
                                <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource PrimaryBrush}" Margin="0,0,2,0"/>
                                <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource PrimaryBrush}" Margin="0,1,2,0"/>
                                <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFEDEA"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#EEBFB8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F9DDD8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B6ABB8"/>
                                <Setter TargetName="Root" Property="Background" Value="#F7F2F0"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#E8DDD9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,4,8,0"
                                        Opacity="0.36"
                                        IsHitTestVisible="False">
                                <Ellipse Width="4" Height="4" Fill="White" Margin="0,0,2,0"/>
                                <Ellipse Width="4" Height="4" Fill="White" Margin="0,1,2,0"/>
                                <Ellipse Width="4" Height="4" Fill="White"/>
                            </StackPanel>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFF7F4"/>
                                <Setter TargetName="Root" Property="Background" Value="#E8B6C5"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#E8B6C5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="#F0C8C8"/>
            <Setter Property="Background" Value="#FFF5F5"/>
        </Style>
        <Style x:Key="WindowCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFE7EE"/>
                                <Setter Property="Foreground" Value="#111018"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFD2DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFCFB"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#E9CFC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#F7F1EF"/>
                                <Setter Property="Foreground" Value="#B6ABB8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#FFFCFB"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#E9CFC8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFDFB"/>
            <Setter Property="BorderBrush" Value="#F0CFC7"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="{StaticResource PawPatternBrush}"/>
            <Setter Property="BorderBrush" Value="#F0C3CF"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style x:Key="PanelHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="CatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="{StaticResource PawPatternBrush}"/>
            <Setter Property="BorderBrush" Value="#F0B9C8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRoot"
                                Background="#FFF8F6"
                                BorderBrush="#F0D4CE"
                                BorderThickness="1"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="TabPawDot"
                                         Width="7"
                                         Height="7"
                                         Fill="#F6B8C8"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"/>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#FFF1EE"/>
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="#F0B9C8"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#FFFDFB"/>
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="#2B2630"/>
                                <Setter TargetName="TabPawDot" Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B6ABB8"/>
                                <Setter TargetName="TabRoot" Property="Background" Value="#F6F1EF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFDFB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F4DDD7"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF8F6"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF0EC"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#F0CFC7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFDFB"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoneySoftBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE6EF"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EmptyCatState" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFC"/>
            <Setter Property="BorderBrush" Value="#F3CAD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFDFB"
                BorderBrush="#2B2630"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid ClipToBounds="True">
                <Grid Width="62" Height="58"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="62,-5,0,0"
                      IsHitTestVisible="False">
                    <Polygon Points="0,41 23,0 48,42"
                             Fill="{StaticResource InkBrush}"
                             Stroke="{StaticResource InkBrush}"
                             StrokeThickness="1.5"/>
                    <Polygon Points="11,39 24,12 38,41"
                             Fill="{StaticResource EarInnerBrush}"/>
                </Grid>

                <Grid Width="62" Height="58"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,-2,214,0"
                      IsHitTestVisible="False">
                    <Polygon Points="4,42 31,0 58,41"
                             Fill="{StaticResource InkBrush}"
                             Stroke="{StaticResource InkBrush}"
                             StrokeThickness="1.5"/>
                    <Polygon Points="15,41 31,12 47,39"
                             Fill="{StaticResource EarInnerBrush}"/>
                </Grid>

                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="176,0,0,0">
                        <Border Width="42"
                                Height="42"
                                CornerRadius="12"
                                Background="White"
                                BorderBrush="#F2D5CE"
                                BorderThickness="1"
                                Margin="0,0,10,0">
                            <Image Source="Assets/CatMascot.png" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <TextBlock Text="技术支持批量提交工具"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Border Background="#FFF7D9"
                                BorderBrush="#FFD66B"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,2"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="喵速处理版 v1.4.0"
                                       Foreground="#8A5A00"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Line X1="0" Y1="11" X2="54" Y2="6"
                              Stroke="{StaticResource WhiskerBrush}"
                              StrokeThickness="1.2"/>
                        <Ellipse Width="9" Height="7"
                                 Fill="{StaticResource EarInnerBrush}"
                                 Margin="10,0"/>
                        <Line X1="0" Y1="6" X2="54" Y2="11"
                              Stroke="{StaticResource WhiskerBrush}"
                              StrokeThickness="1.2"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeWindowButton"
                                Style="{StaticResource WindowCaptionButton}"
                                Content="━"
                                ToolTip="最小化"
                                Click="MinimizeWindow_Click"/>
                        <Button x:Name="MaximizeWindowButton"
                                Style="{StaticResource WindowCaptionButton}"
                                Content="▢"
                                ToolTip="最大化"
                                Click="MaximizeWindow_Click"/>
                        <Button x:Name="CloseWindowButton"
                                Style="{StaticResource WindowCaptionButton}"
                                Background="#FFFFFA"
                                Content="×"
                                ToolTip="关闭"
                                Click="CloseWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LoginColumn" Width="420" MinWidth="0"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="8"/>
                <ColumnDefinition x:Name="WorkspaceColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LoginPane" Grid.Column="0" Style="{StaticResource CatCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource PawPatternBrush}" BorderBrush="#F2D5CE"
                            BorderThickness="0,0,0,1" Padding="12">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="26" Height="22" Margin="0,0,8,0">
                                        <Polygon Points="2,12 8,0 14,12"
                                                 Fill="{StaticResource InkBrush}"/>
                                        <Polygon Points="6,12 9,5 12,12"
                                                 Fill="{StaticResource EarInnerBrush}"/>
                                        <Polygon Points="13,12 20,0 25,12"
                                                 Fill="{StaticResource InkBrush}"/>
                                        <Polygon Points="16,12 20,5 23,12"
                                                 Fill="{StaticResource EarInnerBrush}"/>
                                    </Grid>
                                    <TextBlock Text="守门猫登录台" Style="{StaticResource PanelHeaderText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="最小化"
                                            MinWidth="72"
                                            Click="ToggleLoginCollapse_Click"/>
                                    <Button x:Name="ExpandLoginButton" Content="放大页面"
                                            MinWidth="72"
                                            Click="ToggleLoginPane_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="可拖动右侧分隔条调整宽度。程序不保存密码。"
                                       Style="{StaticResource HintText}" Margin="0,4,0,10"/>
                            <WrapPanel>
                                <Button Content="工作台/重新登录" Click="OpenWorkbench_Click"/>
                                <Button Content="打开技术支持" Click="OpenSupport_Click"/>
                                <Button Content="检查登录" Click="CheckSession_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <wv2:WebView2 x:Name="PlatformWebView" Grid.Row="1"/>
                </Grid>
            </Border>

            <Border x:Name="CollapsedLoginBar"
                    Grid.Column="0"
                    Visibility="Collapsed"
                    Background="#FFF8F6"
                    BorderBrush="#F2D5CE"
                    BorderThickness="1"
                    CornerRadius="14">
                <Button Content="恢复&#x0a;页面"
                        MinWidth="36"
                        Padding="4,12"
                        Margin="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Click="ToggleLoginCollapse_Click"/>
            </Border>

            <GridSplitter x:Name="LoginSplitter"
                          Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="#F2D5CE"
                          ShowsPreview="True"/>

            <Grid Grid.Column="2"
                  Margin="0,0,0,8">
            <TabControl x:Name="WorkspaceTabs"
                        Background="Transparent" BorderThickness="0">
                <TabItem Header="批量提交">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                    <Grid Margin="0,8,0,0" MinHeight="620">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="180"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CatCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="选择 Excel 清单" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="  ฅ 模板先体检，再开始跑"
                                                   Foreground="#B85A75"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="8,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="选择后自动读取并创建备份；点击开始提交时自动校验平台字段"
                                               HorizontalAlignment="Right" Foreground="#657186"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WorkbookPathText" Height="34" Padding="8,5"
                                             IsReadOnly="True" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BrowseButton" Grid.Column="1"
                                            Content="选择并读取" Margin="10,0,0,0"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="BrowseWorkbook_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,10">
                            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                <StackPanel><TextBlock x:Name="TotalText" Text="0" Style="{StaticResource StatValue}"/><TextBlock Text="总数" Style="{StaticResource StatLabel}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                <StackPanel><TextBlock x:Name="SucceededText" Text="0" Style="{StaticResource StatValue}" Foreground="#067647"/><TextBlock Text="成功" Style="{StaticResource StatLabel}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                <StackPanel><TextBlock x:Name="PendingText" Text="0" Style="{StaticResource StatValue}"/><TextBlock Text="待提交" Style="{StaticResource StatLabel}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                <StackPanel><TextBlock x:Name="FailedText" Text="0" Style="{StaticResource StatValue}" Foreground="#B42318"/><TextBlock Text="失败" Style="{StaticResource StatLabel}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                <StackPanel><TextBlock x:Name="ValidationFailedText" Text="0" Style="{StaticResource StatValue}" Foreground="#B54708"/><TextBlock Text="校验失败" Style="{StaticResource StatLabel}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}">
                                <StackPanel><TextBlock x:Name="PendingVerificationText" Text="0" Style="{StaticResource StatValue}" Foreground="#175CD3"/><TextBlock Text="待核验" Style="{StaticResource StatLabel}"/></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <WrapPanel>
                                    <Button x:Name="StartButton" Content="开始提交"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="StartSubmission_Click" IsEnabled="False"/>
                                    <Button x:Name="PauseButton" Content="暂停"
                                            Click="PauseSubmission_Click" IsEnabled="False"/>
                                    <Button x:Name="RetryButton" Content="仅重试失败项"
                                            Click="RetryFailed_Click" IsEnabled="False"/>
                                    <Button x:Name="StopButton" Content="停止"
                                            Style="{StaticResource DangerButton}"
                                            Click="StopSubmission_Click" IsEnabled="False"/>
                                </WrapPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="提交间隔" Foreground="#657186" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SubmissionIntervalText"
                                             Width="58" Height="28" Padding="6,3"
                                             Margin="8,0,4,0"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Text="秒；空白随机 30-90 秒"
                                               Foreground="#657186" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="当前行：" Foreground="#657186"/>
                                    <TextBlock x:Name="CurrentRowText" Text="-" FontWeight="SemiBold" Margin="0,0,18,0"/>
                                    <TextBlock Text="倒计时：" Foreground="#657186"/>
                                    <TextBlock x:Name="CountdownText" Text="00:00" FontWeight="SemiBold"
                                               FontSize="18" Foreground="#175CD3"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10">
                            <Grid>
                            <DataGrid x:Name="TicketGrid" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="All"
                                      BorderThickness="0" ItemsSource="{Binding Rows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="58"/>
                                    <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*"/>
                                    <DataGridTextColumn Header="发现人" Binding="{Binding Discoverer}" Width="95"/>
                                    <DataGridTextColumn Header="申请人" Binding="{Binding Applicant}" Width="95"/>
                                    <DataGridTextColumn Header="事件类型" Binding="{Binding EventType}" Width="100"/>
                                    <DataGridTextColumn Header="所属系统" Binding="{Binding SystemName}" Width="110"/>
                                    <DataGridTextColumn Header="指定受理人" Binding="{Binding Assignee}" Width="105"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="78"/>
                                    <DataGridTextColumn Header="技术支持编号" Binding="{Binding TicketNumber}" Width="110"/>
                                    <DataGridTextColumn Header="实际提交时间"
                                                        Binding="{Binding SubmittedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                        Width="145"/>
                                    <DataGridTextColumn Header="失败原因" Binding="{Binding FailureReason}" Width="2*"/>
                                    <DataGridTextColumn Header="关闭状态" Binding="{Binding CloseStateText}" Width="86"/>
                                    <DataGridTextColumn Header="实际关闭时间"
                                                        Binding="{Binding ClosedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                        Width="145"/>
                                    <DataGridTextColumn Header="关闭失败原因" Binding="{Binding CloseFailureReason}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border x:Name="TicketEmptyState"
                                    Style="{StaticResource EmptyCatState}"
                                    Margin="0,48,0,0">
                                <StackPanel>
                                    <Image Source="Assets/CatMascot.png" Width="90" Height="90" Stretch="Uniform"/>
                                    <TextBlock Text="猫猫还没拿到清单"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Text="先选择 Excel，小爪子再开始排队处理"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource PawPatternBrush}" BorderBrush="#F0C3CF"
                                        BorderThickness="0,0,0,1" Padding="10,7">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🐾" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="运行日志" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="日志不记录描述、密码、Cookie、身份证号或手机号"
                                                       Foreground="#657186" VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                            <Button x:Name="ExportDiagnosticsButton"
                                                    Content="导出诊断包"
                                                    MinHeight="24"
                                                    MinWidth="92"
                                                    Padding="10,3"
                                                    Click="ExportDiagnostics_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ListBox x:Name="LogList" Grid.Row="1" BorderThickness="0"
                                         FontFamily="Consolas" FontSize="12"/>
                            </Grid>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="待受理查询">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                    <Grid Margin="0,8,0,0" MinHeight="560">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="待受理事项 - 未受理" FontSize="16" FontWeight="SemiBold"/>
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="事件标题：" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PendingTitleText" Grid.Column="1"
                                             Height="34" Padding="8,5"
                                             VerticalContentAlignment="Center"/>
                                    <Button x:Name="QueryPendingButton" Grid.Column="2"
                                            Content="查询" Margin="10,0,0,0"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="QueryPending_Click"/>
                                    <Button x:Name="TogglePendingAdvancedButton" Grid.Column="3"
                                            Content="更多条件"
                                            Margin="0"
                                            Click="TogglePendingAdvanced_Click"/>
                                    <Button Grid.Column="4" Content="清空"
                                            Margin="0"
                                            Click="ResetPendingQuery_Click"/>
                                </Grid>
                                <Grid x:Name="PendingAdvancedPanel"
                                      Grid.Row="2"
                                      Visibility="Collapsed"
                                      Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="事件编号：" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PendingCaseIdText" Grid.Column="1" Height="30" Padding="6,3"/>
                                    <TextBlock Grid.Column="2" Text="事件类型：" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    <TextBox x:Name="PendingTypeText" Grid.Column="3" Height="30" Padding="6,3"/>
                                    <TextBlock Grid.Column="4" Text="所属系统：" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    <TextBox x:Name="PendingSystemText" Grid.Column="5" Height="30" Padding="6,3"/>
                                    <TextBlock Grid.Column="6" Text="事件状态：" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    <TextBox x:Name="PendingStatusText" Grid.Column="7" Height="30" Padding="6,3"/>

                                    <TextBlock Grid.Row="1" Text="受理人：" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBox x:Name="PendingAssigneeText" Grid.Row="1" Grid.Column="1" Height="30" Padding="6,3" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="申请人：" VerticalAlignment="Center" Margin="14,8,0,0"/>
                                    <TextBox x:Name="PendingApplicantText" Grid.Row="1" Grid.Column="3" Height="30" Padding="6,3" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="当前处理人：" VerticalAlignment="Center" Margin="14,8,0,0"/>
                                    <TextBox x:Name="PendingHandlerText" Grid.Row="1" Grid.Column="5" Height="30" Padding="6,3" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="6" Text="申请人所属机构：" VerticalAlignment="Center" Margin="14,8,0,0"/>
                                    <TextBox x:Name="PendingCreatorOrgText" Grid.Row="1" Grid.Column="7" Height="30" Padding="6,3" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="2" Text="创建开始：" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <DatePicker x:Name="PendingStartDatePicker" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="创建结束：" VerticalAlignment="Center" Margin="14,8,0,0"/>
                                    <DatePicker x:Name="PendingEndDatePicker" Grid.Row="2" Grid.Column="3" Height="30" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="关闭开始：" VerticalAlignment="Center" Margin="14,8,0,0"/>
                                    <DatePicker x:Name="PendingCloseStartDatePicker" Grid.Row="2" Grid.Column="5" Height="30" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="6" Text="关闭结束：" VerticalAlignment="Center" Margin="14,8,0,0"/>
                                    <DatePicker x:Name="PendingCloseEndDatePicker" Grid.Row="2" Grid.Column="7" Height="30" Margin="0,8,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="查询结果" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="  共 " Foreground="#657186"/>
                                    <TextBlock x:Name="PendingResultTotalText" Text="0" FontWeight="SemiBold"/>
                                    <TextBlock Text=" 条" Foreground="#657186"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Margin="16,0,0,0"
                                           MaxWidth="720">
                                    <TextBlock x:Name="CloseProgressText" Text="请选择需要关闭的记录"
                                               Foreground="#526176" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="关贴间隔" Foreground="#657186" VerticalAlignment="Center"/>
                                        <TextBox x:Name="CloseIntervalText"
                                                 Width="52" Height="28" Padding="6,3"
                                                 Margin="8,0,4,0"
                                                 VerticalContentAlignment="Center"/>
                                        <TextBlock Text="秒" Foreground="#657186" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="BulkCloseButton" Content="批量关闭"
                                            Click="BulkClose_Click"/>
                                    <Button x:Name="TogglePendingDetailColumnsButton"
                                            Content="展开详情"
                                            Click="TogglePendingDetailColumns_Click"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,12,0">
                                        <TextBlock Text="倒计时：" Foreground="#657186" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CloseCountdownText" Text="00:00"
                                                   FontWeight="SemiBold" Foreground="#175CD3"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="PauseCloseButton" Content="暂停"
                                            Margin="8,0,0,0" Visibility="Collapsed" Click="PauseClose_Click"/>
                                    <Button x:Name="StopCloseButton" Content="停止"
                                            Margin="8,0,0,0" Visibility="Collapsed" Click="StopClose_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                            <ScrollViewer x:Name="PendingTicketHorizontalScroller"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                            <DataGrid x:Name="PendingTicketGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      BorderThickness="0"
                                      FrozenColumnCount="6"
                                      ColumnWidth="SizeToHeader"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ItemsSource="{Binding PendingTickets}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="72">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox x:Name="SelectAllPendingCheckBox"
                                                      Content="全选"
                                                      IsThreeState="True"
                                                      Click="SelectAllPending_Click"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanClose}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Click="PendingSelection_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="编号" Binding="{Binding CaseId}" Width="96" MinWidth="92" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="标题" Binding="{Binding CaseTitle}" Width="210" MinWidth="170" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="操作" Width="84" MinWidth="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="关闭"
                                                        IsEnabled="{Binding CanClose}"
                                                        MinWidth="56" Padding="8,4"
                                                        Click="ClosePendingTicket_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StatusName}" Width="72" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="关闭状态" Binding="{Binding CloseStateText}" Width="88" MinWidth="84" IsReadOnly="True"/>
                                    <DataGridTextColumn x:Name="PendingTypeColumn" Header="事件类型" Binding="{Binding TypeName}" Width="100" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="PendingSystemColumn" Header="所属系统" Binding="{Binding SystemName}" Width="110" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="PendingAssigneeColumn" Header="受理人" Binding="{Binding Assignee}" Width="90" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="PendingHandlerColumn" Header="当前处理人" Binding="{Binding CurrentHandler}" Width="100" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="PendingApplicantColumn" Header="申请人" Binding="{Binding Applicant}" Width="90" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="PendingCreateTimeColumn" Header="申请时间" Binding="{Binding CreateTime}" Width="150" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="PendingLatestReplyTimeColumn" Header="最近回复时间" Binding="{Binding LatestReplyTime}" Width="150" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="PendingCloseMessageColumn" Header="处理结果" Binding="{Binding CloseMessage}" Width="150" MinWidth="140" IsReadOnly="True" Visibility="Collapsed"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            </ScrollViewer>
                            <Border x:Name="PendingEmptyState"
                                    Style="{StaticResource EmptyCatState}"
                                    Margin="0,48,0,0">
                                <StackPanel>
                                    <Image Source="Assets/CatMascot.png" Width="90" Height="90" Stretch="Uniform"/>
                                    <TextBlock Text="暂时没有待处理记录"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Text="输入标题点查询，猫猫会把可关闭的单子叼回来"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="提交清单关闭">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                    <Grid Margin="0,8,0,0" MinHeight="560">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="按当前 Excel 提交清单关闭" FontSize="16" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="清单记录" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="  共 " Foreground="#657186"/>
                                    <TextBlock x:Name="ExcelCloseResultTotalText" Text="0" FontWeight="SemiBold"/>
                                    <TextBlock Text=" 条" Foreground="#657186"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Margin="16,0,0,0"
                                           MaxWidth="760">
                                    <TextBlock x:Name="ExcelCloseProgressText" Text="请先选择 Excel 清单"
                                               Foreground="#526176" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="关贴间隔" Foreground="#657186" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExcelCloseIntervalText"
                                                 Width="52" Height="28" Padding="6,3"
                                                 Margin="8,0,4,0"
                                                 VerticalContentAlignment="Center"/>
                                        <TextBlock Text="秒" Foreground="#657186" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="RefreshExcelCloseButton" Content="查询清单"
                                            Click="RefreshExcelCloseList_Click"/>
                                    <Button x:Name="BulkCloseExcelButton" Content="批量关闭"
                                            Click="BulkCloseExcel_Click"/>
                                    <Button x:Name="ToggleExcelCloseDetailColumnsButton"
                                            Content="展开详情"
                                            Click="ToggleExcelCloseDetailColumns_Click"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,12,0">
                                        <TextBlock Text="倒计时：" Foreground="#657186" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ExcelCloseCountdownText" Text="00:00"
                                                   FontWeight="SemiBold" Foreground="#175CD3"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="PauseExcelCloseButton" Content="暂停"
                                            Margin="8,0,0,0" Visibility="Collapsed" Click="PauseClose_Click"/>
                                    <Button x:Name="StopExcelCloseButton" Content="停止"
                                            Margin="8,0,0,0" Visibility="Collapsed" Click="StopClose_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                            <ScrollViewer x:Name="ExcelCloseTicketHorizontalScroller"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                            <DataGrid x:Name="ExcelCloseTicketGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      BorderThickness="0"
                                      FrozenColumnCount="6"
                                      ColumnWidth="SizeToHeader"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ItemsSource="{Binding ExcelCloseTickets}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="72">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox x:Name="SelectAllExcelCloseCheckBox"
                                                      Content="全选"
                                                      IsThreeState="True"
                                                      Click="SelectAllExcelClose_Click"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanClose}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Click="ExcelCloseSelection_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="编号" Binding="{Binding CaseId}" Width="96" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="标题" Binding="{Binding CaseTitle}" Width="210" MinWidth="170" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="操作" Width="84">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="关闭"
                                                        IsEnabled="{Binding CanClose}"
                                                        MinWidth="56" Padding="8,4"
                                                        Click="CloseExcelTicket_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StatusName}" Width="72" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="关闭状态" Binding="{Binding CloseStateText}" Width="86" IsReadOnly="True"/>
                                    <DataGridTextColumn x:Name="ExcelCloseTypeColumn" Header="事件类型" Binding="{Binding TypeName}" Width="100" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="ExcelCloseSystemColumn" Header="所属系统" Binding="{Binding SystemName}" Width="110" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="ExcelCloseAssigneeColumn" Header="指定受理人" Binding="{Binding Assignee}" Width="105" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="ExcelCloseApplicantColumn" Header="申请人" Binding="{Binding Applicant}" Width="90" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="ExcelCloseCreateTimeColumn" Header="提交时间" Binding="{Binding CreateTime}" Width="150" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="ExcelCloseClosedAtColumn" Header="关闭时间"
                                                        Binding="{Binding ClosedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                        Width="150" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="ExcelCloseMessageColumn" Header="处理结果" Binding="{Binding CloseMessage}" Width="180" IsReadOnly="True" Visibility="Collapsed"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            </ScrollViewer>
                            <Border x:Name="ExcelCloseEmptyState"
                                    Style="{StaticResource EmptyCatState}"
                                    Margin="0,48,0,0">
                                <StackPanel>
                                    <Image Source="Assets/CatMascot.png" Width="90" Height="90" Stretch="Uniform"/>
                                    <TextBlock Text="清单里还没有可关闭记录"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Text="先读取提交清单，再让猫猫逐条收尾"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="历史记录">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                    <Grid Margin="0,8,0,0" MinHeight="560">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="本地历史记录" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="历史保存在本机 recovery.db，不记录描述、密码、Cookie、身份证号或手机号。"
                                               Foreground="#657186" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="刷新历史" Click="RefreshHistory_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <TabItem Header="提交历史">
                                <Border Style="{StaticResource Card}" Padding="0" Margin="0,8,0,0">
                                    <DataGrid AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="All"
                                              BorderThickness="0"
                                              ItemsSource="{Binding SubmissionHistory}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="时间"
                                                                Binding="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                                Width="150"/>
                                            <DataGridTextColumn Header="编号" Binding="{Binding CaseId}" Width="105"/>
                                            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*"/>
                                            <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="90"/>
                                            <DataGridTextColumn Header="事件类型" Binding="{Binding EventType}" Width="100"/>
                                            <DataGridTextColumn Header="所属系统" Binding="{Binding SystemName}" Width="110"/>
                                            <DataGridTextColumn Header="申请人" Binding="{Binding Applicant}" Width="90"/>
                                            <DataGridTextColumn Header="指定受理人" Binding="{Binding Assignee}" Width="105"/>
                                            <DataGridTextColumn Header="Excel路径" Binding="{Binding WorkbookPath}" Width="260"/>
                                            <DataGridTextColumn Header="工作表" Binding="{Binding WorksheetName}" Width="90"/>
                                            <DataGridTextColumn Header="Excel行" Binding="{Binding ExcelRowNumber}" Width="70"/>
                                            <DataGridTextColumn Header="结果" Binding="{Binding Message}" Width="180"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </TabItem>

                            <TabItem Header="关闭历史">
                                <Border Style="{StaticResource Card}" Padding="0" Margin="0,8,0,0">
                                    <DataGrid AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="All"
                                              BorderThickness="0"
                                              ItemsSource="{Binding CloseHistory}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="时间"
                                                                Binding="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                                Width="150"/>
                                            <DataGridTextColumn Header="来源" Binding="{Binding SourceKind}" Width="130"/>
                                            <DataGridTextColumn Header="编号" Binding="{Binding CaseId}" Width="105"/>
                                            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*"/>
                                            <DataGridTextColumn Header="关闭状态" Binding="{Binding StateText}" Width="90"/>
                                            <DataGridTextColumn Header="事件类型" Binding="{Binding EventType}" Width="100"/>
                                            <DataGridTextColumn Header="所属系统" Binding="{Binding SystemName}" Width="110"/>
                                            <DataGridTextColumn Header="申请人" Binding="{Binding Applicant}" Width="90"/>
                                            <DataGridTextColumn Header="受理人" Binding="{Binding Assignee}" Width="90"/>
                                            <DataGridTextColumn Header="Excel路径" Binding="{Binding WorkbookPath}" Width="260"/>
                                            <DataGridTextColumn Header="工作表" Binding="{Binding WorksheetName}" Width="90"/>
                                            <DataGridTextColumn Header="Excel行" Binding="{Binding ExcelRowNumber}" Width="70"/>
                                            <DataGridTextColumn Header="结果" Binding="{Binding Message}" Width="180"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#FFF6F3" BorderBrush="#F0C3CF" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            MaxWidth="430">
                    <TextBlock Text="🐾" Foreground="#FF7B9C" Margin="0,0,6,0"/>
                    <TextBlock x:Name="SessionStatusText"
                               Text="正在初始化登录页面"
                               Foreground="#D88600"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CurrentUserText"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="10,0,0,0"
                               MaxWidth="120"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="喵速处理台"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="FooterStatusText" Text="未选择 Excel"
                           Grid.Column="2"
                           MaxWidth="430"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
